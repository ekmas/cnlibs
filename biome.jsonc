{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedAttributes": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/public/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      // Docs scaffolds keep a fragment wrapper so more examples can be added.
      "includes": ["**/content/docs/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessFragments": "off"
          }
        }
      }
    },
    {
      "includes": ["**/components/ui/**", "**/hooks/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "noRedundantRoles": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noUselessUndefined": "off",
            "useSimplifiedLogicExpression": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "noUnusedImports": "off",
            "useExhaustiveDependencies": "off"
          },
          "nursery": {
            "useSortedClasses": "off"
          },
          "performance": {
            "noJsxPropsBind": "off",
            "noNamespaceImport": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "style": {
            "noExportedImports": "off",
            "noNegationElse": "off",
            "noNestedTernary": "off",
            "useBlockStatements": "off",
            "useConsistentArrowReturn": "off",
            "useConsistentObjectDefinitions": "off",
            "useConsistentTypeDefinitions": "off",
            "useImportType": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off",
            "noEqualsToNull": "off",
            "noLeakedRender": "off",
            "noShadow": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
